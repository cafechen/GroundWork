  sizeBytes   BigInt
  createdAt   DateTime      @default(now()) @db.Timestamp(3)
  run         SimulationRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([runId, role])
}

// Append-only event; resource IDs deliberately have no FK to mutable rows.
// 只追加事件；资源标识故意不关联可删除当前行，历史审计须保留。
model AuditEvent {
  id            BigInt   @id @default(autoincrement())
  at            DateTime @default(now()) @db.Timestamp(3)
  actor         String   @db.VarChar(120)
