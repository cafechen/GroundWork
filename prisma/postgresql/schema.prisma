// Execution status is NOT a scenario verdict. CONTACT can be completed.
// 执行完成不等于作业成功；CONTACT 与 completed 可同时出现。
model SimulationRun {
  id                 String        @id @default(uuid()) @db.VarChar(80)
  parkId             String?       @db.VarChar(80)
  parkVersion        Int?
  taskId             String?       @db.VarChar(80)
  engine             RunEngine
  engineVersion      String        @db.VarChar(120)
  codeFingerprint    String        @db.VarChar(200)
  status             RunStatus
  verdict            String?       @db.VarChar(80)
  inputSnapshot      Json
  inputHash          String        @db.Char(64)
  metrics            Json?
  error              Json?
  cancelRequestedAt  DateTime?     @db.Timestamp(3)
  leaseOwner         String?       @db.VarChar(120)
  leaseExpiresAt     DateTime?     @db.Timestamp(3)
  createdAt          DateTime      @default(now()) @db.Timestamp(3)
  startedAt          DateTime?     @db.Timestamp(3)
  finishedAt         DateTime?     @db.Timestamp(3)
  parkRevision       ParkRevision? @relation(fields: [parkId, parkVersion], references: [parkId, version], onDelete: Restrict, onUpdate: Restrict)
  artifacts          RunArtifact[]

  @@index([parkId, createdAt])
  @@index([parkId, parkVersion])
  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
}

// Relative artifact keys, not arbitrary paths/URLs / 受限相对路径，不接受任意路径或 URL。
model RunArtifact {
  id          String        @id @default(uuid()) @db.VarChar(80)
  runId       String        @db.VarChar(80)
  role        String        @db.VarChar(80)
  mediaType   String        @db.VarChar(120)
  storageKey  String        @db.VarChar(500)
