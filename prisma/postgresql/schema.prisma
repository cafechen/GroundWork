// Resource identity / 地图资源身份。currentVersion is transactionally maintained.
model MapAsset {
  id             String       @id @default(uuid()) @db.VarChar(80)
  name           String       @db.VarChar(120)
  currentVersion Int
  archivedAt     DateTime?    @db.Timestamp(3)
  createdAt      DateTime     @default(now()) @db.Timestamp(3)
  updatedAt      DateTime     @updatedAt @db.Timestamp(3)
  versions       MapVersion[]
}

// Immutable canonical map, including levels/source/geometry / 不可变完整地图文档。
model MapVersion {
  mapId        String   @db.VarChar(80)
  version      Int
  name         String   @db.VarChar(120)
  document     Json
  contentHash  String   @db.Char(64)
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  map          MapAsset @relation(fields: [mapId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parkMaps     ParkMap[]

  @@id([mapId, version])
}

