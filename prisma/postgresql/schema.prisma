  @@unique([gatewayId, name])
  @@unique([gatewayId, id])
}

// One optimistic revision for every aggregate edit / 园区聚合统一乐观锁版本。
model Park {
  id          String         @id @default(uuid()) @db.VarChar(80)
  name        String         @db.VarChar(120)
  description String         @db.Text
  version     Int            @default(1)
  archivedAt  DateTime?       @db.Timestamp(3)
  createdAt   DateTime        @default(now()) @db.Timestamp(3)
  updatedAt   DateTime        @updatedAt @db.Timestamp(3)
  revisions   ParkRevision[]
  maps        ParkMap[]
  models      ParkModel[]
  gateways    ParkGateway[]
  devices     DeviceInstance[]
  objects     SceneObject[]
  tasks       Task[]
}

// Append-only snapshot, written atomically with current rows and audit.
// 只追加快照，与当前业务行和审计在同一事务写入。
model ParkRevision {
  parkId      String          @db.VarChar(80)
  version     Int
  snapshot    Json
  contentHash String          @db.Char(64)
  createdAt   DateTime        @default(now()) @db.Timestamp(3)
  park        Park            @relation(fields: [parkId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  runs        SimulationRun[]

  @@id([parkId, version])
}

model ParkMap {
  parkId     String           @db.VarChar(80)
  mapId      String           @db.VarChar(80)
