}

// Scoped IDs preserve existing IDs even when two parks use the same device ID.
// 园区内复合主键保留旧 ID，允许不同园区中出现同名 ID。
model DeviceInstance {
  parkId    String                 @db.VarChar(80)
  id        String                 @default(uuid()) @db.VarChar(80)
  name      String                 @db.VarChar(120)
  kind      DeviceKind
  modelId   String                 @db.VarChar(80)
