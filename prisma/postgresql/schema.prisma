  park         Park               @relation(fields: [parkId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model        DeviceModelVersion @relation(fields: [modelId, modelVersion], references: [modelId, version], onDelete: Restrict, onUpdate: Restrict)
