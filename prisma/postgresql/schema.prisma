  levelKey  String                 @db.VarChar(120)
  x         Float                  @db.DoublePrecision
  y         Float                  @db.DoublePrecision
  yaw       Float                  @db.DoublePrecision
  gatewayId String?                @db.VarChar(80)
  serial    String?                @db.VarChar(200)
  park      Park                   @relation(fields: [parkId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model     ParkModel              @relation(fields: [parkId, modelId], references: [parkId, modelId], onDelete: Restrict, onUpdate: Restrict)
  map       ParkMap                @relation(fields: [parkId, mapId], references: [parkId, mapId], onDelete: Restrict, onUpdate: Restrict)
  gateway   ParkGateway?           @relation(fields: [parkId, gatewayId], references: [parkId, gatewayId], onDelete: Restrict, onUpdate: Restrict)
  channels  DeviceChannelBinding[]
  tasks     Task[]

  @@id([parkId, id])
  @@index([parkId, modelId])
  @@index([parkId, mapId])
  @@index([parkId, gatewayId])
}

model DeviceChannelBinding {
  parkId    String         @db.VarChar(80)
