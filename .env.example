# MySQL default. Use a dedicated GroundWork database, never an existing app DB.
# MySQL 默认；必须使用独立 GroundWork 数据库。
DATABASE_PROVIDER=mysql
DATABASE_URL="mysql://groundwork:change-me@127.0.0.1:3306/groundwork"
# PostgreSQL: regenerate client and apply its OWN migration history.
# PG：先重新生成客户端，再应用 PG 专用迁移；不是只改连接串。
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://groundwork:change-me@127.0.0.1:5432/groundwork?schema=public"
GROUNDWORK_ARTIFACTS=data/next-runs
NEXT_TELEMETRY_DISABLED=1
# Trusted LAN only; no login/authentication. Defaults are localhost/127.0.0.1.
# 仅可信局域网，无登录认证；不授权公网暴露。
GROUNDWORK_ALLOWED_HOSTS=
