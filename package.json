{
  "name": "groundwork-workbench",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first simulation and validation workbench for industrial vehicles.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@groundwork/contracts": "0.1.0",
    "@groundwork/scenario-engine": "0.1.0",
    "three": "0.180.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "22.10.0",
    "vitest": "3.2.4"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "npm run build -w @groundwork/contracts && npm run build -w @groundwork/scenario-engine",
    "test:engines": "vitest run --config vitest.config.ts",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs"
  }
}
