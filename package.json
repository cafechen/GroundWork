{
  "name": "groundwork-workbench",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first simulation and validation workbench for industrial vehicles.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@groundwork/contracts": "0.1.0",
    "@groundwork/scenario-engine": "0.1.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.180.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4173",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 4173",
    "build": "npm run build:engines && npm run db:generate && NEXT_TELEMETRY_DISABLED=1 next build",
    "build:engines": "npm run build -w @groundwork/contracts && npm run build -w @groundwork/scenario-engine",
    "legacy:start": "node scripts/serve.mjs",
    "worker": "node --import tsx workers/runner.ts",
    "db:generate": "node scripts/prisma-provider.mjs --generate",
    "db:schema:mysql": "node scripts/prisma-provider.mjs mysql",
    "db:schema:postgresql": "node scripts/prisma-provider.mjs postgresql",
    "db:migrate:mysql": "prisma migrate deploy --schema prisma/mysql/schema.prisma",
    "db:migrate:postgresql": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:seed": "node --import tsx scripts/seed-next.ts",
    "db:import:sqlite": "node --import tsx scripts/import-sqlite.ts",
    "db:import:runs": "node --import tsx scripts/import-runs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src workers tests-next --max-warnings=0",
    "test:next": "node --import tsx --test tests-next/*.test.js",
    "test:database": "node --import tsx --test tests-next/database.integration.js",
    "test:engines": "vitest run --config vitest.config.ts",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs && npm run typecheck"
  }
}
